# Copy to .env and fill in. Never commit .env.

TELEGRAM_BOT_TOKEN=123456:ABC...
# Empty → bot starts in fallback mode (no Claude calls).
ANTHROPIC_API_KEY=
# <telegram_id>:<slug>, comma-separated. The first entry is the admin.
ALLOWED_TELEGRAM_IDS=111111111:jack,222222222:partner
# Optional until the bot has joined: add the bot to the group as the admin and it will post the id.
GROUP_CHAT_ID=
# Household timezone: all "day" boundaries (budgets, caps) use it.
TZ=Asia/Singapore
LOG_LEVEL=INFO
# DATA_DIR=/data

# Optional (§10.4): seeds the forum topic Tykee answers in, on first run only. Easier: send
# /settopic inside the topic as the admin, or pick it in the dashboard.
# GROUP_TOPIC_ID=

# Dashboard (§11), http://<nas>:8081 on the LAN. Without both values the dashboard stays off.
# Generate them with:  docker compose run --rm tykee python -m app.dashboard.hashpw
# Keep the single quotes: compose interpolates $ in env_file values.
# DASHBOARD_PASSWORD_HASH='$argon2id$...'
# SESSION_SECRET='...'   # 32+ random characters

# Optional (§10.7): read-only account reader. From https://my.telegram.org (API development
# tools), plus a Fernet key you generate (see README). Keep this file outside the data dir so
# backups never hold a usable session. Then: docker exec -it tykee python -m app.reader.login
# TG_API_ID=
# TG_API_HASH=
# READER_SESSION_KEY=
