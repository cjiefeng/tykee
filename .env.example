# Copy to .env and fill in. Never commit .env.

TELEGRAM_BOT_TOKEN=123456:ABC...
# Empty → bot starts in fallback mode (no Claude calls).
ANTHROPIC_API_KEY=
# <telegram_id>:<slug>, comma-separated. The first entry is the admin.
ALLOWED_TELEGRAM_IDS=111111111:jack,222222222:partner
# Optional until the bot has joined: add the bot to the group as the admin and it will post the id.
GROUP_CHAT_ID=
# Household timezone: all "day" boundaries (budgets, caps) use it.
TZ=Asia/Singapore
LOG_LEVEL=INFO
# DATA_DIR=/data

# M4 (dashboard). Single-quote the hash: compose interpolates $ in env_file values.
# DASHBOARD_PASSWORD_HASH='$argon2id$...'
# SESSION_SECRET=
